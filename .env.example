# --- DocMind configuration example ---
# Copy this to .env and fill in your key.

# Required: your Google Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Optional overrides
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=            # auto-detected if left blank

UPLOAD_MAX_SIZE_MB=25
CHUNK_SIZE=900
CHUNK_OVERLAP=150
VECTOR_TOP_K=8
CONTEXT_TOP_K=4
MIN_SIMILARITY=0.35
